# Python bytecode and tool caches
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.envrc

# Streamlit secrets must never be committed
.streamlit/secrets.toml

# IDE and operating-system files
.vscode/*
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
tempCodeRunnerFile.py

# Local/raw datasets. Keep the reproducible mock dataset used by the demo.
data/*

# Processed data is generated locally by the cleaning pipeline and read by the dashboard.
data/processed/*
# Keep the generated demo dataset tracked in the repository.
!data/processed/cleaned_data.csv

# không ignore .gitkeep giữ khung thư mục
!**/.gitkeep

# không theo dõi thư mục specs
specs/*
